# GPT-Live-1 / OpenAI Realtime API
GPT_LIVE_API_KEY=your_openai_api_key_here
GPT_LIVE_ENDPOINT=wss://api.openai.com/v1/realtime?model=gpt-4o-realtime-preview-2024-10-01

# Council Seat Model Providers
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_for_llama_here
MISTRAL_API_KEY=your_mistral_api_key_here

# ==========================================
# TELEGRAM Y3K CHANNEL CONFIGURATION
# ==========================================
# Telegram Bot Token obtained via @BotFather
TELEGRAM_BOT_TOKEN="your_telegram_bot_token_here"

# Target Telegram Channel ID or Username (e.g., @y3K_channel or -100xxxxxxxxxx)
TELEGRAM_Y3K_CHANNEL_ID="your_target_channel_id_here"

# Admin User IDs permitted to execute administrative commands or trigger manual broadcasts
# Format: comma-separated list of Telegram numeric user IDs
TELEGRAM_ADMIN_IDS="admin_user_id_1,admin_user_id_2"

# Security Webhook Secret Token for incoming Telegram update verification
TELEGRAM_WEBHOOK_SECRET="your_secure_webhook_secret_here"

